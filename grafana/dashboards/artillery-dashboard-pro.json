{
  "title": "Artillery Load Testing - Pro Dashboard",
  "uid": "artillery-pro",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "annotations": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Latency",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery_http_response_time\" and (r[\"_field\"] == \"median\" or r[\"_field\"] == \"p95\" or r[\"_field\"] == \"p99\") and not exists r.class)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        }
      },
      "interval": "10s"
    },
    {
      "type": "timeseries",
      "title": "Request Rate (RPS)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery\" and (r[\"_field\"] == \"http_requests\"))\n  |> group()\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)\n  |> map(fn: (r) => ({ r with _value: float(v: r._value) / (float(v: int(v: v.windowPeriod)) / 1000000000.0) }))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "interval": "10s"
    },
    {
      "type": "timeseries",
      "title": "HTTP Response Codes",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery_http_codes\")\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)",
          "refId": "A"
        }
      ],
      "interval": "10s"
    },
    {
      "type": "timeseries",
      "title": "Scenarios Completed",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery\" and (r[\"_field\"] == \"vusers_completed\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)",
          "refId": "A"
        }
      ],
      "interval": "10s"
    },
    {
      "type": "timeseries",
      "title": "Scenario Throughput",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery_vusers_created_by_name\")\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)",
          "refId": "A"
        }
      ],
      "interval": "10s"
    },
    {
      "type": "timeseries",
      "title": "Scenario Duration",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery_vusers_session_length\" and (r[\"_field\"] == \"median\" or r[\"_field\"] == \"p95\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "interval": "10s"
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery\" and (r[\"_field\"] == \"http_requests\"))\n  |> group()\n  |> sum()",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Success Rate",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery_http_codes\")\n  |> group()\n  |> reduce(identity: {ok: 0.0, all: 0.0}, fn: (r, accumulator) => ({ok: accumulator.ok + (if r._field =~ /^2/ then float(v: r._value) else 0.0), all: accumulator.all + float(v: r._value)}))\n  |> map(fn: (r) => ({_value: if r.all > 0.0 then r.ok / r.all * 100.0 else 0.0}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "yellow",
                "value": 98
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Avg Scenario Duration",
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery_vusers_session_length\" and (r[\"_field\"] == \"mean\" or r[\"_field\"] == \"count\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.mean and exists r.count)\n  |> group()\n  |> reduce(identity: {total: 0.0, n: 0.0}, fn: (r, accumulator) => ({total: accumulator.total + r.mean * r.count, n: accumulator.n + r.count}))\n  |> map(fn: (r) => ({_value: if r.n > 0.0 then r.total / r.n else 0.0}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Throughput (req/min)",
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"artillery\" and (r[\"_field\"] == \"http_request_rate\"))\n  |> group()\n  |> mean()\n  |> map(fn: (r) => ({ r with _value: r._value * 60.0 }))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "displayName": "req/min"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
